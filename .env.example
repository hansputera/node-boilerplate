# =============================================================================
# Environment Configuration
# =============================================================================
# This file documents all required environment variables.
# Copy this file to .env.{environment} and fill in the values for local dev.
#
# For encrypted environment files, use SOPS:
#   sops edit .env.dev.encrypted
#   sops decrypt .env.dev.encrypted
# =============================================================================

# Application
NODE_ENV=development
PORT=3000
HEALTH_PORT=3001

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# Redis
REDIS_URL=redis://localhost:6379

# API Keys
API_KEY=your-api-key-here
SECRET_KEY=your-secret-key-here

# JWT (if using authentication)
JWT_SECRET=your-jwt-secret-here
JWT_EXPIRATION=7d

# AWS (if using AWS services or AWS KMS with SOPS)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# Logging
LOG_LEVEL=info

# External Services
# EXTERNAL_API_URL=https://api.example.com
# EXTERNAL_API_KEY=your-external-api-key
